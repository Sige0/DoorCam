SECRET_KEY=change-me
LOGIN_USER=admin
LOGIN_PASSWORD_HASH=

# PC: 127.0.0.1, Pi: 0.0.0.0 (local network only, no port forwarding!)
HOST=127.0.0.1

# PC: 0 = webcam, "test" = test image
# Pi: /dev/v4l/by-id/usb-046d_...-video-index0
CAMERA_SOURCE=0

# brightness difference 0-255, lower = more sensitive
MOTION_THRESHOLD=25
# min moving area in % of image
MOTION_MIN_AREA=1.0
# more than this % changed at once = light on/off, ignored
MOTION_LIGHT_CHANGE=60
# event ends after X seconds without motion (= recording after motion)
MOTION_END_SECONDS=5

# seconds recorded before the motion
RECORD_PRE_SECONDS=5
# max length of one recording, then a new one starts
RECORD_MAX_SECONDS=120
# length of the manual clip (last X seconds)
CLIP_SECONDS=60

# recordings older than this are deleted (1440 = 24 h)
RETENTION_MINUTES=1440
# below this free space, oldest recordings are deleted first
MIN_FREE_GB=2

# away mode starts after X seconds, so leaving the flat gives no alarm
AWAY_DELAY_SECONDS=60

# mail in away mode (Gmail: smtp.gmail.com, app password without spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# several receivers separated by comma
MAIL_TO=
# at most one mail every X minutes
MAIL_COOLDOWN_MINUTES=5
# photo for the mail X seconds after motion starts
MAIL_PHOTO_DELAY_SECONDS=1
